{
  "name": "teensurance-mvp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:cert": "node scripts/build-cert.mjs",
    "test:roadready": "vitest run lib/roadready/roadready.test.ts app/api/roadready/route.test.ts",
    "test:roadready:e2e": "playwright test --config=playwright.roadready.config.ts",
    "roadready:certify": "node scripts/roadready-certify.mjs",
    "security:certify": "vitest run lib/platform/legacy-security.test.ts lib/platform/service.test.ts app/api/workspace/route.test.ts lib/roadready/roadready.test.ts app/api/roadready/route.test.ts lib/roadready/intelligence.test.ts app/api/roadready/intelligence/route.test.ts",
    "roadready:intelligence:certify": "npm run roadready:certify",
    "persistence:certify": "vitest run --config vitest.persistence.config.ts && vitest run --config vitest.postgres.config.ts",
    "roadready:content:certify": "vitest run --config vitest.content.config.ts && vitest run lib/roadready/review.test.ts",
    "pilot:certify": "vitest run lib/pilot/service.test.ts lib/platform/operations.test.ts && playwright test --config=playwright.pilot.config.ts",
    "test:scout": "vitest run lib/roadready/roadready.test.ts app/api/scout/route.test.ts app/api/scout/intelligence/route.test.ts",
    "test:scout:e2e": "playwright test --config=playwright.roadready.config.ts",
    "scout:certify": "node scripts/scout-certify.mjs",
    "legacy-namespace:check": "node scripts/check-legacy-roadready.mjs",
    "test:waitlist": "vitest run lib/waitlist/service.test.ts",
    "brand:certify": "node scripts/brand-certify.mjs",
    "jurisdiction:certify": "node scripts/jurisdiction-certify.mjs",
    "test:insurance": "vitest run lib/insurance",
    "test:insurance:e2e": "playwright test --config=playwright.insurance.config.ts",
    "insurance:architecture:certify": "node scripts/insurance-architecture-certify.mjs",
    "insurance:certify": "node scripts/insurance-certify.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "^15.0.0",
    "pg": "^8.23.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "ts-morph": "^28.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
