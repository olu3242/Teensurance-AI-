# Dedicated Teensurance Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google provider credentials belong in Supabase Auth provider configuration,
# never in NEXT_PUBLIC_* variables and never committed to this repository.

# Scout Learning feature flag; disabled until explicitly enabled.
SCOUT_LEARNING_ENABLED=false
# Temporary backward-compatible alias. Remove after hosted environments migrate.
ROADREADY_LEARNING_ENABLED=false
# Optional: existing platform SQLite location, outside version control.
# TEENSURANCE_DB_PATH=data/teensurance.sqlite
