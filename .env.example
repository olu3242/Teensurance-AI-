# Dedicated Teensurance Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google provider credentials belong in Supabase Auth provider configuration,
# never in NEXT_PUBLIC_* variables and never committed to this repository.

# Scout Learning feature flag; disabled until explicitly enabled.
SCOUT_LEARNING_ENABLED=false
# Temporary backward-compatible alias. Remove after hosted environments migrate.
ROADREADY_LEARNING_ENABLED=false
# Optional: existing platform SQLite location, outside version control.
# TEENSURANCE_DB_PATH=data/teensurance.sqlite

# One operational store: Neon project icy-tree-05791271 in hosted environments.
TEENSURANCE_PERSISTENCE=sqlite
# Hosted: TEENSURANCE_PERSISTENCE=postgres, TEENSURANCE_ENV=production.
# Runtime login must be a member of restricted teensurance_runtime, not migration owner.
DATABASE_URL=
# Direct migration-owner connection; never expose to browser or runtime deployments.
DATABASE_MIGRATION_URL=
# Explicit server-maintained operational account IDs. Empty denies access.
TEENSURANCE_ADMIN_USER_IDS=
TEENSURANCE_REVIEWER_USER_IDS=
# Automatically enforced on Vercel/production, even when omitted/false.
ROADREADY_REQUIRE_HUMAN_REVIEW=false

# Controlled pilot enrollment (off until operational launch gates pass).
PILOT_ENABLED=false
